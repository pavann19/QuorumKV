# Reviewable example only; operator must provision the user, paths and identity.
[Unit]
Description=QuorumKV authenticated member
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=quorumkv
Group=quorumkv
ExecStart=/opt/quorumkv/quorumkv-node -id=node1 -peers=node1=10.20.0.11:7070,node2=10.20.0.12:7070,node3=10.20.0.13:7070 -data-dir=/var/lib/quorumkv/node1 -identity=/etc/quorumkv/node1.json -admin-addr=127.0.0.1:7071
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/quorumkv/node1
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=1G
CPUQuota=100%
TasksMax=128
LimitNOFILE=4096
UMask=0077
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
